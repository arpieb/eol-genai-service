# EOL Trait Query Service — environment configuration sample.
#
# Copy to `.env` (git-ignored) and fill in secrets. The app loads `.env` at startup
# (config.load_env), and real environment variables take precedence over `.env`.
# Every value here is OPTIONAL except EOL_JWT (only needed for the live EOL integration);
# the defaults shown reproduce the offline-fixture build.

# ── Upstream EOL ────────────────────────────────────────────────────────────────
# Shared admin JWT for https://eol.org/service/cypher (request from the EOL maintainer).
# SECRET — set only in your local .env, never commit. Leave unset for the offline build.
EOL_JWT=

# EOL Cypher endpoint and response format (defaults shown).
EOL_CYPHER_URL=https://eol.org/service/cypher
EOL_FORMAT=cypher

# ── Upstream care (Principle VII) ───────────────────────────────────────────────
EOL_RESULT_CAP=100                  # deliberate result cap; truncation is always flagged
EOL_TERM_CACHE_TTL_SECONDS=86400    # term-list cache TTL (24h)
EOL_UPSTREAM_TIMEOUT_SECONDS=10.0
EOL_UPSTREAM_MAX_RETRIES=2          # bounded retry with backoff (never a tight loop)

# ── Service-side extractor (Principle V; scoped, constrained-decoded) ────────────
# Default: Mellea on local Ollama Granite — no key, offline.
# Backends are Mellea's own: ollama | openai | litellm | hf | watsonx. Hosted providers are reached
# *through* litellm, so the frontier upgrade is backend=litellm + a prefixed model id, e.g.
# EOL_SERVICE_MODEL_BACKEND=litellm with EOL_SERVICE_MODEL_ID=anthropic/claude-sonnet-5-5.
EOL_SERVICE_MODEL_BACKEND=ollama    # ollama | openai | litellm | hf | watsonx
EOL_SERVICE_MODEL_ID=granite4.1:3b
# Endpoint override. Unset = the backend's own default (Ollama → http://localhost:11434). Set it for
# a non-localhost Ollama, an OpenAI-compatible gateway, or self-hosted vLLM.
# EOL_SERVICE_MODEL_API_BASE=       # e.g. http://ollama:11434 or http://litellm-gateway:4000

# ── Embeddings / term→URI grounding (Principle IV) ──────────────────────────────
# Backends: local (in-process fastembed/ONNX — no server, no key; the MCP server's default) |
# ollama (local server) | voyage (hosted). `local` is the self-contained choice for containers.
EOL_EMBEDDINGS_BACKEND=ollama       # local | ollama | voyage
EOL_EMBEDDINGS_MODEL_ID=mxbai-embed-large   # local → mixedbread-ai/mxbai-embed-large-v1; voyage → voyage-3-large
# EOL_EMBEDDINGS_CACHE_DIR=          # local only: where fastembed stores/loads the ONNX weights
# Endpoint override for the embedding provider. Unset = litellm's provider default (Ollama →
# http://localhost:11434). Ignored by the `local` backend, which runs the model in-process.
# EOL_EMBEDDINGS_API_BASE=           # e.g. http://ollama:11434 or http://litellm-gateway:4000

# ── Provider credentials (consumed by the provider SDKs, only for the upgrades above) ──
# Required only when the corresponding backend is selected. SECRET — keep in .env only.
# ANTHROPIC_API_KEY=        # when EOL_SERVICE_MODEL_ID=anthropic/<model> (backend=litellm)
# EMBEDDINGS_API_KEY=       # Voyage key, when EOL_EMBEDDINGS_BACKEND=voyage

# ── Serving (console scripts `eol-genai-api` / `eol-genai-mcp`) ──────────────────
# HTTP API host/port.
EOL_API_HOST=0.0.0.0
EOL_API_PORT=8000
# MCP server transport: stdio (local subprocess clients) | streamable-http (serves the standard
# MCP /mcp endpoint for networked clients) | sse (legacy). Host/port apply to the HTTP transports.
EOL_MCP_TRANSPORT=stdio
EOL_MCP_HOST=0.0.0.0
EOL_MCP_PORT=8765

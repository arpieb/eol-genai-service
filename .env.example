# EOL Trait Query Service — environment configuration sample.
#
# Copy to `.env` (git-ignored) and fill in secrets. The app loads `.env` at startup
# (config.load_env), and real environment variables take precedence over `.env`.
# Every value here is OPTIONAL except EOL_JWT (only needed for the live EOL integration);
# the defaults shown reproduce the offline-fixture build.

# ── Upstream EOL ────────────────────────────────────────────────────────────────
# Shared admin JWT for https://eol.org/service/cypher (request from the EOL maintainer).
# SECRET — set only in your local .env, never commit. Leave unset for the offline build.
EOL_JWT=

# EOL Cypher endpoint and response format (defaults shown).
EOL_CYPHER_URL=https://eol.org/service/cypher
EOL_FORMAT=cypher

# ── Upstream care (Principle VII) ───────────────────────────────────────────────
EOL_RESULT_CAP=100                  # deliberate result cap; truncation is always flagged
EOL_TERM_CACHE_TTL_SECONDS=86400    # term-list cache TTL (24h)
EOL_UPSTREAM_TIMEOUT_SECONDS=10.0
EOL_UPSTREAM_MAX_RETRIES=2          # bounded retry with backoff (never a tight loop)

# ── Service-side extractor (Principle V; scoped, constrained-decoded) ────────────
# Default: Mellea on local Ollama Granite — no key, offline.
EOL_SERVICE_MODEL_BACKEND=ollama    # ollama | anthropic
EOL_SERVICE_MODEL_ID=granite4.1:3b  # e.g. claude-sonnet-4-6 when backend=anthropic

# ── Embeddings / term→URI grounding (Principle IV) ──────────────────────────────
# Default: local Ollama embeddings — no key, off the per-query hot path.
EOL_EMBEDDINGS_BACKEND=ollama       # ollama | voyage
EOL_EMBEDDINGS_MODEL_ID=mxbai-embed-large   # e.g. voyage-3-large when backend=voyage

# ── Provider credentials (consumed by the provider SDKs, only for the upgrades above) ──
# Required only when the corresponding backend is selected. SECRET — keep in .env only.
# ANTHROPIC_API_KEY=        # when EOL_SERVICE_MODEL_BACKEND=anthropic
# EMBEDDINGS_API_KEY=       # Voyage key, when EOL_EMBEDDINGS_BACKEND=voyage
